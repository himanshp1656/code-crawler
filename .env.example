# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/code_crawler

# ── Admin portal ──────────────────────────────────────────────────────────────
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me

# ── Default tenant (used by run_connector.py CLI) ───────────────────────────
DEFAULT_TENANT_ID=default
DEFAULT_TENANT_NAME=default

# ── Public showcase (no-login demo for visitors / HR) ───────────────────────
SHOWCASE_ENABLED=true
SHOWCASE_TENANT_ID=showcase
SHOWCASE_TENANT_NAME=Code Crawler Demo

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_SECRET_KEY=change-me

# ── LiteLLM (used for AI analysis features) ───────────────────────────────────
LITELLM_API_KEY=

# ── Nginx / Temporal UI (used by setup_services.sh) ───────────────────────────
TEMPORAL_UI_USER=
TEMPORAL_UI_PASSWORD=
